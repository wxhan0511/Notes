						<td colspan="5">2.0.0.146</td>
					</tr>
					<tr>
						<td colspan="2">Host</td>
						<td colspan="5">ZJ-AE-4363</td>
					</tr>
					<tr>
						<td colspan="2">Device</td>
						<td colspan="5">0000-0000-0000-0000</td>
					</tr>
					<tr>
						<td colspan="2">Time</td>
						<td colspan="5">2026/6/1 10:49:40</td>
					</tr>
					<!-- <tr>
						<td colspan="2">warnings</td>
						<td colspan="5">0</td>
					</tr> -->
					<tr>
						<th width="20">#</th>
						<th width="50">Type</th>
						<th width="150">Item</th>
						<th width="200">Subitem</th>
						<th width="250">Value</th>
						<th>Description</th>
						<!-- <th width="280">GUID</th>
						<th>Hr</th> -->

						<!-- <th>Time (UTC)</th> -->
					</tr>
					<xsl:apply-templates/>
				</table>

			</body>
		</xsl:template>

		<xsl:template match="entry">
			<!-- example 

          <entry>
            <record>136</record>
            <time>2004/02/26 00:42:59.706</time>
            <type>Error</type>
            <source>Microsoft Visual Studio</source>
            <description>Loading UI library</description>
            <guid>{00000000-0000-0000-0000-000000000000}</guid>
            <hr>800a006f</hr>
            <path></path>
        </entry>

        -->
			<xsl:choose>

				<xsl:when test="type='Information'">
					<tr id="info" class="info">
						<td>
							<xsl:value-of select="record"/>
						</td>
						<td></td>
						<xsl:call-template name="row"/>
					</tr>
				</xsl:when>

				<xsl:when test="type='Warning'">
					<tr id="warning" class="warning">
						<td>
							<xsl:value-of select="record"/>
						</td>
						<td>Warning</td>
						<xsl:call-template name="row"/>
					</tr>
				</xsl:when>

				<xsl:when test="type='Error'">
					<tr id="error" class="error">
						<td>
							<xsl:value-of select="record"/>
						</td>
						<td>ERROR</td>
						<xsl:call-template name="row"/>
					</tr>
				</xsl:when>

			</xsl:choose>

		</xsl:template>

		<xsl:template name="row">
			<td id="item">
				<xsl:value-of select="item"/>
			</td>
			<td id="subitem">
				<xsl:value-of select="subitem"/>
			</td>
			<td>
				<xsl:value-of select="value"/>
			</td>
			<td id="description">
				<xsl:value-of select="description"/>
				<xsl:if test="path">
					<br/>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;<xsl:value-of select="path"/>
				</xsl:if>
			</td>
			<!-- <td id="guid">
				<xsl:value-of select="guid"/>
			</td>
			<td id="hr">
				<xsl:value-of select="hr"/>
			</td> -->

			<!-- <td>
				<xsl:value-of select="time"/>
			</td> -->
		</xsl:template>

